# Copy this file to .env and fill in ONE of the provider blocks.

# --- Option A: Claude (default). Native citations. Get a key at https://console.anthropic.com ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5        # best quality (default)
# ANTHROPIC_MODEL=claude-haiku-5-5       # much cheaper, still supports citations
# ANTHROPIC_EFFORT=medium                # low | medium | high

# --- Option B: any OpenAI-compatible API (NVIDIA NIM, Groq, Together, Ollama) ---
# LLM_PROVIDER=openai_compat
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=meta/llama-3.3-70b-instruct

# --- Option C: no LLM at all. Returns the best passages verbatim (demo / retrieval testing) ---
# LLM_PROVIDER=extractive

# --- Retrieval ---
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# For Urdu or mixed-language documents use a multilingual model, then delete data/ and re-upload:
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RERANK_ENABLED=true
# TOP_K=6

# --- Storage: unset = embedded Qdrant in ./data. Set to use a Qdrant server or Qdrant Cloud ---
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
